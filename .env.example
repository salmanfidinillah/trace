# Public Firebase web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Server Firebase Admin configuration. Use a service account JSON string or
# Application Default Credentials in the cloud. Never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local/cloud ADC alternative. Keep service-account JSON outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# Breach provider
# Competition MVP uses the explicitly labelled TRACE Demo Dataset.
TRACE_BREACH_PROVIDER=demo
TRACE_BREACH_ENDPOINT=
# Server-side only. Never expose this as NEXT_PUBLIC_ or commit the value.
TRACE_BREACH_API_KEY=

# Vertex AI / Gemini (primary AI provider; set false only for an intentional local fallback)
VERTEX_AI_ENABLED=true
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-2.5-flash-lite
# Optional on Vercel when ADC is not available. Firebase Admin credentials can also be reused.
VERTEX_AI_CLIENT_EMAIL=
VERTEX_AI_PRIVATE_KEY=

# Runtime controls
TRACE_RUNTIME_ENV=development
TRACE_PUBLIC_SCAN_LIMIT=10
TRACE_REQUIRE_APP_CHECK=false
