# Public Firebase web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server Firebase Admin configuration. Use a service account JSON string or
# Application Default Credentials in the cloud. Never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Breach provider
TRACE_BREACH_PROVIDER=demo
TRACE_BREACH_ENDPOINT=
TRACE_BREACH_API_KEY=

# Optional Vertex AI
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash-001

# Runtime controls
TRACE_RUNTIME_ENV=development
TRACE_PUBLIC_SCAN_LIMIT=10
TRACE_REQUIRE_APP_CHECK=false
