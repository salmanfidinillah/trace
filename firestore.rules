rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if false;

      match /scans/{scanId} {
        allow read: if owner(uid);
        allow write: if false;

        match /exposures/{exposureId} {
          allow read: if owner(uid);
          allow write: if false;
        }
      }

      match /recommendations/{recommendationId} {
        allow read: if owner(uid);
        allow create, delete: if false;
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'completedAt'])
          && request.resource.data.status in ['todo', 'in_progress', 'done'];
      }

      match /checklist/{itemId} {
        allow read: if owner(uid);
        allow create, delete: if false;
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['todo', 'done'];
      }

      match /alerts/{alertId} {
        allow read: if owner(uid);
        allow create, delete: if false;
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
      }

      match /aiAnalyses/{analysisId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /auditEvents/{eventId} {
        allow read, write: if false;
      }
    }

    match /providerCache/{cacheKey} {
      allow read, write: if false;
    }

    match /systemRateLimits/{bucketId} {
      allow read, write: if false;
    }

    match /systemConfigs/{configId} {
      allow read, write: if false;
    }
  }
}
